# .env.example — copy to .env for local development
# Never commit .env to git

# ── Required ──────────────────────────────────────────────────────────────────
GITHUB_APP_ID=                    # Numeric ID from your GitHub App settings
GITHUB_PRIVATE_KEY=               # Paste full PEM content (replace \n with newlines)
GITHUB_WEBHOOK_SECRET=            # Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
GROQ_API_KEY=                     # From console.groq.com (free tier available)
MCP_API_KEY=                      # REQUIRED. MCP endpoint fails closed (503) if unset. Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
METRICS_AUTH_TOKEN=               # Any strong random string for /metrics endpoint

# ── Local triage gate (optional, free) ────────────────────────────────────────
# With OLLAMA_HOST set, a local model is asked one cheap question before any
# cloud call on a pull request: does this change contain logic worth reviewing?
# Version bumps, lockfile churn, formatting and comment edits are skipped, so
# the cloud quota is spent on changes a reviewer actually wants.
#
# The gate can only ever SKIP work. If the local model is unreachable, slow or
# incoherent, the answer is "review it" — identical to having no gate. There is
# deliberately no setting that makes it strict.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b
# GATEKEEPER_ENABLED=1        # 0 disables the gate even with Ollama configured
# GATEKEEPER_TIMEOUT=8        # seconds to wait for the local verdict

# Public base URL of this deployment, e.g. https://autopilot.onrender.com
# Used by /setup to tell GitHub where to send webhooks and where to redirect
# after creating the App. Unset falls back to the incoming request's host,
# which is correct in most cases but wrong behind a proxy that rewrites Host.
# PUBLIC_URL=

# ── Optional ──────────────────────────────────────────────────────────────────
# How many reverse proxies sit in front of this app. This decides which entry
# of X-Forwarded-For is trustworthy, and therefore what the per-IP rate limit
# actually limits.
#
#   0  no proxy — ignore the header entirely and use the socket address.
#      REQUIRED if you expose this app directly: with no proxy, the whole
#      header is attacker-supplied, so trusting it lets a flood pick a fresh
#      rate-limit bucket on every request.
#   1  one proxy — Render, Fly, most PaaS. This is the default.
#   2  two — e.g. Cloudflare in front of a platform router.
#
# Wrong in either direction is silent, so don't guess: once traffic has
# arrived, `/setup/doctor` compares this against the chains actually seen
# and tells you which value your topology implies.
TRUSTED_PROXY_HOPS=1

MCP_API_KEYS=                      # Named keys "laptop:tok1,ci:tok2" — per-client revocation + attributable mcp.audit log lines. Combinable with MCP_API_KEY (label "default").
MCP_ALLOWED_INSTALLATIONS=         # Comma-separated GitHub App installation IDs the MCP tools may act on. Unset = allow all (single-tenant).
REDIS_URL=redis://localhost:6379/0 # Leave blank for in-memory fallback (dev only)
QDRANT_URL=                        # Qdrant Cloud URL for code embedding search
QDRANT_API_KEY=                    # Qdrant Cloud API key

# ── App config (defaults shown) ───────────────────────────────────────────────
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=text                    # text (local dev) | json (production)
PORT=5000

# ── Durable event queue (V6) ─────────────────────────────────────────────
# In-process consumer threads for the Redis-backed webhook queue.
# Set to 0 only when running a dedicated `python worker.py` service.
EVENT_QUEUE_CONSUMERS=2
# Bounded queue length — beyond this webhooks get 503 (GitHub retries).
EVENT_QUEUE_MAX_LEN=200

# ── AI quality (V6.2) ─────────────────────────────────────────────────────
# LLM_QUALITY_FLOOR=high  # reviews/fixes REFUSE to run on a basic-tier model
#                         # (Groq 8B / OpenRouter) instead of degrading silently.
#                         # Fast tasks (labels, commit lint) are unaffected.
# Every posted comment now discloses which model produced it.

# ── Local LLM / privacy (V6) ─────────────────────────────────────────────
# Run inference on hardware you control so source code never leaves your infra.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b
# LLM_LOCAL_ONLY=1     # Ollama or nothing — NO cloud provider ever contacted
# LLM_PREFER_LOCAL=1   # try Ollama first, fall back to cloud on failure

# ── Repository memory / the brain (V6) ───────────────────────────────────
# MEMORY_MAX_ITEMS=500   # per-repo cap on stored memories (bounds free-tier Redis)
#
# By default (unset) recalled memory is injected into a prompt ONLY when a local
# model is active (LLM_LOCAL_ONLY / LLM_PREFER_LOCAL) — this is "local-only":
# sensitive learned context never reaches a cloud LLM. Set the flag to override:
# MEMORY_ALLOW_CLOUD=1   # also allow memory in cloud prompts (accepts egress)
#
# Encrypted backup (optional). Leave unset to keep memory local-only. To enable,
# generate a real key and paste it below — do NOT commit the real value:
#   python -m app.core.memory_backup genkey
# MEMORY_BACKUP_KEY=REPLACE_WITH_GENERATED_FERNET_KEY
#
# All three below are required together for automatic backup. A key with no
# destination encrypts something and then drops it, so a partial configuration
# counts as unconfigured rather than half-working. Use a PRIVATE repo: only
# ciphertext is uploaded, but the blob's size and cadence are still metadata.
# MEMORY_BACKUP_REPO=you/private-backup
# MEMORY_BACKUP_TOKEN=REPLACE_WITH_PAT_WITH_CONTENTS_WRITE
# MEMORY_BACKUP_PATH=memory.bin

# ── Scheduled maintenance ─────────────────────────────────────────────────────
# Every N days: a full security scan of every repository the app has seen an
# event for, then the encrypted memory export above. The schedule is stored in
# Redis as a due time, so a restart does not reset it.
# MAINTENANCE_INTERVAL_DAYS=15
# MAINTENANCE_ENABLED=1

# ── Model selection ───────────────────────────────────────────────────────────
# Model choice is a DEPLOYMENT concern, not a per-repo one: the router is a
# process-wide singleton, so a repo-level override would let one tenant change
# the model every other tenant gets. V7.1.0 moved these out of repo config for
# that reason. Unset means the router's own defaults.
# LLM_PRIMARY_MODEL=openai/gpt-oss-120b
# LLM_FALLBACK_MODEL=openai/gpt-oss-20b

# ── Operational limits ────────────────────────────────────────────────────────
# Largest event envelope that may go into the Redis queue. Anything bigger
# skips the durable path and is dispatched directly, because parking a huge
# payload in a 25MB Redis costs more than replaying the delivery would.
# EVENT_QUEUE_MAX_ITEM_BYTES=524288
#
# Redis memory usage that triggers a warning on /health, as a percentage.
# REDIS_MEMORY_WARN_PCT=80
#
# Where /graph.json reads the committed dependency map from. CI regenerates
# this file; the endpoint serves it rather than rebuilding per request, which
# would report the DEPLOYED tree instead of the repository.
# CODEGRAPH_PATH=docs/diagrams/codegraph.json

# ── Environment detection ─────────────────────────────────────────────────────
# Either of these set to "production" makes an unset REDIS_URL a hard startup
# failure instead of a silent fall back to the in-memory store — losing
# idempotency and rate limiting in production should not be survivable.
# ENVIRONMENT=production
# FLASK_ENV=production
