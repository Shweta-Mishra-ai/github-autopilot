# .env.example — copy to .env for local development
# Never commit .env to git

# ── Required ──────────────────────────────────────────────────────────────────
GITHUB_APP_ID=                    # Numeric ID from your GitHub App settings
GITHUB_PRIVATE_KEY=               # Paste full PEM content (replace \n with newlines)
GITHUB_WEBHOOK_SECRET=            # Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
GROQ_API_KEY=                     # From console.groq.com (free tier available)
MCP_API_KEY=                      # REQUIRED. MCP endpoint fails closed (503) if unset. Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
METRICS_AUTH_TOKEN=               # Any strong random string for /metrics endpoint

# ── Optional ──────────────────────────────────────────────────────────────────
MCP_ALLOWED_INSTALLATIONS=         # Comma-separated GitHub App installation IDs the MCP tools may act on. Unset = allow all (single-tenant).
REDIS_URL=redis://localhost:6379/0 # Leave blank for in-memory fallback (dev only)
QDRANT_URL=                        # Qdrant Cloud URL for code embedding search
QDRANT_API_KEY=                    # Qdrant Cloud API key

# ── App config (defaults shown) ───────────────────────────────────────────────
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=text                    # text (local dev) | json (production)
PORT=5000

# ── Durable event queue (V6) ─────────────────────────────────────────────
# In-process consumer threads for the Redis-backed webhook queue.
# Set to 0 only when running a dedicated `python worker.py` service.
EVENT_QUEUE_CONSUMERS=2
# Bounded queue length — beyond this webhooks get 503 (GitHub retries).
EVENT_QUEUE_MAX_LEN=200

# ── Local LLM / privacy (V6) ─────────────────────────────────────────────
# Run inference on hardware you control so source code never leaves your infra.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b
# LLM_LOCAL_ONLY=1     # Ollama or nothing — NO cloud provider ever contacted
# LLM_PREFER_LOCAL=1   # try Ollama first, fall back to cloud on failure

# ── Repository memory / the brain (V6) ───────────────────────────────────
# MEMORY_MAX_ITEMS=500   # per-repo cap on stored memories (bounds free-tier Redis)
#
# By default (unset) recalled memory is injected into a prompt ONLY when a local
# model is active (LLM_LOCAL_ONLY / LLM_PREFER_LOCAL) — this is "local-only":
# sensitive learned context never reaches a cloud LLM. Set the flag to override:
# MEMORY_ALLOW_CLOUD=1   # also allow memory in cloud prompts (accepts egress)
#
# Encrypted backup (optional). Leave unset to keep memory local-only. To enable,
# generate a real key and paste it below — do NOT commit the real value:
#   python -c "from app.core.memory_backup import generate_key; print(generate_key())"
# MEMORY_BACKUP_KEY=REPLACE_WITH_GENERATED_FERNET_KEY
